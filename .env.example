# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/automanual?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Providers (Automatic failover: Gemini -> Groq -> OpenAI)
# 1. Google Gemini (100% Free tier, 15 RPM from https://aistudio.google.com)
GEMINI_API_KEY=""

# 2. Groq (100% Free tier, Llama 3.3 70B from https://console.groq.com)
GROQ_API_KEY=""

# 3. OpenAI (Optional paid fallback)
OPENAI_API_KEY=""

# Security & Encryption (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage
STORAGE_PATH="./storage"

# Server Ports & URLs
PORT=4001
NEXT_PUBLIC_API_URL="http://localhost:4001"

# Browser Runner Options
PLAYWRIGHT_HEADLESS=false
